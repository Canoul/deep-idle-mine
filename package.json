{
  "name": "deep-idle-mine",
  "version": "0.1.0",
  "private": true,
  "description": "Idle game navigateur : un mineur autonome explore une mine 2D en blocs pendant des sessions d'1 h. Serveur Node sans dépendance (jeu + comptes).",
  "type": "module",
  "scripts": {
    "start": "node server/main.js",
    "dev": "node server/dev.js",
    "dev:presets": "node scripts/dev-presets.js",
    "dev:history": "node scripts/dev-history.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:anticheat": "node --test \"tests/anticheat/*.test.js\"",
    "simulate": "node scripts/simulate.js",
    "simulate:mi": "node scripts/simulate-instant.js",
    "simulate:prison": "node scripts/simulate-prison.js",
    "simulate:tower": "node scripts/simulate-tower.js",
    "simulate:giant": "node scripts/simulate-giant.js",
    "simulate:instance": "node scripts/simulate-instance.js",
    "simulate:golbute": "node scripts/simulate-golbute.js",
    "weights": "node scripts/weights.js",
    "stat-values": "node scripts/stat-values.js",
    "textures": "python scripts/gen_textures.py",
    "textures:ui": "python scripts/gen_ui.py && python scripts/build_pxicons.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
